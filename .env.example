# ==============================================================================
# UPSHIFT PLATFORM ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env.local for local development.
# DO NOT COMMIT ACTUAL SECRETS TO GIT.
# ==============================================================================

# Client-Safe Supabase Configuration (Exposed to browser via Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Client-Safe Web3Forms Access Key for Public Lead Notifications
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Client-Safe Razorpay Public Key ID (Exposed to browser via Vite)
VITE_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE

# ==============================================================================
# SERVER-SIDE / SUPABASE EDGE FUNCTION SECRETS
# Configure in Supabase Dashboard (Settings > Functions > Secrets) or CLI
# NEVER prefix with VITE_ or expose to the frontend.
# ==============================================================================
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE
